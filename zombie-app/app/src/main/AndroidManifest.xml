<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets NEXUS (signed by the same developer, nobody else) close this app when you go back to NEXUS -->
    <permission android:name="com.gamehub.permission.CLOSE_APP" android:protectionLevel="signature" />
    <queries>
        <package android:name="com.gamehub.app" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash" />
        <receiver
            android:name=".CloseReceiver"
            android:exported="true"
            android:permission="com.gamehub.permission.CLOSE_APP">
            <intent-filter>
                <action android:name="com.gamehub.action.CLOSE_APP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
