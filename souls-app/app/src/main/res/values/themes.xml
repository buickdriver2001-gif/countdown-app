<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Start-up screen in NEXUS's deep blue, so opening from NEXUS is one smooth fade -->
        <item name="android:windowSplashScreenBackground">#02040E</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#02040E</item>
    </style>
</resources>
