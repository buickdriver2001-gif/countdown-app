<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The games this hub can open -->
    <queries>
        <package android:name="com.zombiedots.app" />
        <package android:name="com.ashenvow.app" />
        <package android:name="com.synthpad.app" />
        <!-- The live Countdown tile reads your Countdown app's countdown -->
        <package android:name="com.countdown.app" />
        <provider android:authorities="com.countdown.app.countdown" />
        <!-- Lets "Add an app" list the apps on the phone -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets NEXUS find the phone's normal home screen -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Lets "Clear all" / swipe-up close apps in the background -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Only used when you tap "Match wallpaper to NEXUS" -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- System screen: shows the connection type and speed estimate -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Closing Zombie Dots, Ashen Vow and SynthPad when you leave them for NEXUS (same developer only) -->
    <permission android:name="com.gamehub.permission.CLOSE_APP" android:protectionLevel="signature" />
    <uses-permission android:name="com.gamehub.permission.CLOSE_APP" />
    <!-- Swipe down on NEXUS opens the notifications (when the helper isn't on) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" when holding an app: opens Android's own uninstall confirmation -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets NEXUS be chosen as the phone's Home app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- NEXUS Recent Apps (the square button screen) -->
        <activity
            android:name=".SwitcherActivity"
            android:exported="false"
            android:theme="@style/SwitcherTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="com.gamehub.app.switcher"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- NEXUS System: diagnostics, device info, tests and shortcuts -->
        <activity
            android:name=".SystemActivity"
            android:exported="false"
            android:theme="@style/SwitcherTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- NEXUS lock screen (shown on top of the phone's real lock screen, only if switched on) -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.gamehub.app.lock"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/SwitcherTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- NEXUS helper (the user turns it on in Accessibility settings) -->
        <service
            android:name=".NexusAccessibility"
            android:exported="true"
            android:label="NEXUS Recent Apps"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nexus_accessibility" />
        </service>

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash" />
    </application>
</manifest>
