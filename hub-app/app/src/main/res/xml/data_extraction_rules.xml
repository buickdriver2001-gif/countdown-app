<?xml version="1.0" encoding="utf-8"?>
<!-- Android's backups and phone-to-phone transfers keep your NEXUS layout and settings, but never the pictures of
     your apps or the diagnostic logs -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="snaps/" />
        <exclude domain="file" path="lock_trace.txt" />
        <exclude domain="file" path="problem_report.txt" />
        <exclude domain="file" path="last_crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="snaps/" />
        <exclude domain="file" path="lock_trace.txt" />
        <exclude domain="file" path="problem_report.txt" />
        <exclude domain="file" path="last_crash.txt" />
    </device-transfer>
</data-extraction-rules>
